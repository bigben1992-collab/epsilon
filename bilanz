<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lager Beta - Bilanz & Rohgewinn</title>
  <style>
    body { font-family: sans-serif; margin: 15px; background: #f4f6f8; }
    nav { background: #fff; padding: 10px; border-radius: 6px; margin-bottom: 15px; display: flex; gap: 10px; flex-wrap: wrap; }
    nav a { text-decoration: none; color: #2563eb; font-weight: bold; }
    .card { background: #fff; padding: 15px; border-radius: 6px; margin-bottom: 15px; }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 15px; }
    .box { padding: 15px; border-radius: 6px; background: #f8fafc; border: 1px solid #e2e8f0; text-align: center; }
    .box h3 { margin: 0 0 10px 0; font-size: 14px; color: #64748b; }
    .box p { margin: 0; font-size: 22px; font-weight: bold; color: #0f172a; }
    .profit { color: #16a34a !important; }
  </style>
</head>
<body>
  <nav>
    <a href="index.html">Buchen (EK/VK)</a> |
    <a href="artikel.html">Artikel & Druck</a> |
    <a href="platz.html">Platzabfrage</a> |
    <a href="bilanz.html">Bilanz</a> |
    <a href="verwaltung.html">Verwaltung</a>
  </nav>

  <div class="card">
    <h2>Finanz- & Gewinnübersicht</h2>
    <div class="grid">
      <div class="box">
        <h3>Gesamter Wareneinkauf</h3>
        <p id="ekVal">0,00 €</p>
      </div>
      <div class="box">
        <h3>Umsatz (Verkäufe)</h3>
        <p id="vkVal">0,00 €</p>
      </div>
      <div class="box">
        <h3>Erzielter Rohgewinn</h3>
        <p id="profitVal" class="profit">0,00 €</p>
      </div>
      <div class="box">
        <h3>Aktueller Lagerwert (EK)</h3>
        <p id="stockVal">0,00 €</p>
      </div>
    </div>
  </div>

  <script>
    const API_URL = "https://script.google.com/macros/s/AKfycbwp9yMSa_6WerEL7CIUmDyKdH9G73DZVgbOFmjMQZrxf8IWSEPAbY-mrOlAZT6BoG7P/exec";

    function formatEUR(val) {
      return new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR' }).format(val);
    }

    async function loadFinance() {
      try {
        let res = await fetch(`${API_URL}?action=getFinance`, { redirect: "follow" });
        let result = await res.json();
        
        if (result.status === "success") {
          document.getElementById('ekVal').innerText = formatEUR(result.data.wareneinsatzEK);
          document.getElementById('vkVal').innerText = formatEUR(result.data.umsatzVK);
          
          let profitElem = document.getElementById('profitVal');
          profitElem.innerText = formatEUR(result.data.rohgewinn);
          
          if (Number(result.data.rohgewinn) < 0) {
            profitElem.style.color = "#dc2626";
          } else {
            profitElem.style.color = "#16a34a";
          }
          
          document.getElementById('stockVal').innerText = formatEUR(result.data.lagerwert);
        }
      } catch (err) {
        console.error("Fehler beim Laden der Bilanzdaten:", err);
      }
    }

    loadFinance();
  </script>
</body>
</html>

